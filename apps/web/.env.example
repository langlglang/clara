# Copy to apps/web/.env.local. Keys live only in the server's environment; never commit real values.
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
# Shared credential for one-frame camera inspection; set the same value on the Pi.
CLARA_BOX_TOKEN=
# Separate token for every /api/admin read and action. Enter it on /admin; keep it off public clients.
CLARA_ADMIN_TOKEN=
# "stub" uses the keyword stub model when there is no Anthropic key (demo only, no network calls).
CLARA_MODEL=stub
# Whole voice-turn budget on the server; the box waits 8-10 s, so keep margin.
CLARA_TURN_BUDGET_MS=6500
# Demo boxes that get a simulated heartbeat every 30 s (comma-separated, or "none"). Remove a box's id once its
# real hardware is connected so its own heartbeats decide whether it is online.
CLARA_SIMULATED_BOXES=box-clinic,box-room-101,box-water-point
# Demo setting: minutes until an ambulance can reach the site, shown on the console and ride offers. Unset = "not known".
CLARA_AMBULANCE_ETA_MIN=35
# Response coordinator (LangChain deepagents): "on" (default) runs the deep agent when ANTHROPIC_API_KEY is set
# and is off without it; "rules" runs the deterministic planner (no key, demo); "off" disables it.
CLARA_COORDINATOR=on
# Model for the deep agent (default claude-opus-5-5) and its effort ("low" default, or "medium").
CLARA_COORDINATOR_MODEL=
CLARA_COORDINATOR_EFFORT=low
# Optional LangSmith tracing of coordinator runs (LangChain reads these itself).
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=clara-coordinator
# Web push for the companion app (PWA). Generate a pair once with `npx web-push generate-vapid-keys`. Without them the
# server generates a pair at start and keeps it in memory, so phones must re-subscribe after every restart.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Phone-call fallback (Twilio REST API): an alert or ride offer unseen for 30 s calls volunteers who gave a number and
# agreed to calls. Without these three, the server only logs "would call +1******1234". A trial account can only call
# numbers verified in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public origin Twilio calls back on (signature checks use it). Default https://clara.living.
PUBLIC_BASE_URL=https://clara.living
# Text alerts over Photon (photon.codes, Beta API) for volunteers who chose iMessage/WhatsApp/SMS. Without the key and
# project id the server only logs "would message +1******1234". The webhook secret (whsec_...) comes from
# `npx tsx scripts/photon-setup.ts --webhook`; without it POST /api/photon/webhook answers 403.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=pho_prj_01m7cbytt4fahstv8xerqw8w8z
PHOTON_WEBHOOK_SECRET=
# Snapshot persistence (docs/persistence.md). Empty: state stays in memory and resets on restart.
# e.g. postgres://user:pass@localhost:5432/clara
DATABASE_URL=

# Demo "911": when an SOS opens, Twilio calls this phone (the team's demo dispatcher) with a briefing.
# Full E.164 number, e.g. +15551234567. Emergency numbers (911, 112, 999...) are always refused.
CLARA_DEMO_911_NUMBER=
# Admin kit placement planner (/admin). All optional; each missing source degrades with a message.
# Local path of the CoStar hackathon extract (never commit it or anything derived from it).
COSTAR_DATA_DIR=
# Matterport Model API (GraphQL) key and token, and the Showcase SDK key (browser-safe, used for the 3D tour).
MP_API_KEY=
MP_API_TOKEN=
MP_SDK_KEY=
# Vexcel API v2 key (parcel, footprint, aerial image).
VEXCEL_API_KEY=
# Planner: "rules" forces the deterministic planner; otherwise the deep agent runs when ANTHROPIC_API_KEY is set.
CLARA_PLANNER=
CLARA_PLANNER_MODEL=
