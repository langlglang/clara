# /etc/clara-box.env: settings for clara-box.service (read by systemd; KEY=value, no quotes needed).
# Find device names with `arecord -L` and `aplay -L`. The speaker rule (85-clara-audio.rules) names a known
# soundbar "Speaker"; check the mic's card name with `arecord -l`.
CLARA_MIC_DEVICE=plughw:CARD=Device,DEV=0
CLARA_SPEAKER_DEVICE=default:CARD=Speaker
# Leave unset to find the ESP32 by USB vendor; or pin it, e.g. /dev/serial/by-id/usb-Silicon_Labs_CP2102N_...-if00-port0
#CLARA_SERIAL_PORT=
# The Clara server the box talks to (no API keys here: they live only on the server).
CLARA_SERVER_URL=https://clara.living
# Optional shared credential for consented one-frame cloud camera inspection. Match Render's CLARA_BOX_TOKEN.
#CLARA_BOX_TOKEN=
# Which box this is. The demo site's boxes are box-clinic, box-room-101 and box-water-point.
CLARA_BOX_ID=box-room-101
CLARA_BOX_NAME=Room 101
# A checked textual fallback for the mock SOS screen. No city or coordinates are inferred from this string.
CLARA_BOX_ADDRESS=1455 California Ave
# Optional USB GNSS receiver. Set to its stable /dev/serial/by-id path on the Pi. GPS stays local to the box.
#CLARA_GPS_PORT=/dev/serial/by-id/usb-u-blox_AG_-_www.u-blox.com_u-blox_7_-_GPS_GNSS_Receiver-if00
