# Adapted from Sophi (github.com/mzhao1599/sophi), devices/pi/systemd/steady-walker.service.
# Clara's always-on box service: lid and LEDs over USB serial, mic, speaker, screen server on :8787.
# install-pi.sh fills in @USER@ and @REPO@ (the person who ran it with sudo, and this checkout).
[Unit]
Description=Clara box service (ESP32 link, audio, screen server, cloud link)
Wants=network-online.target
After=network-online.target sound.target
# Always restart, however often it crashes (systemd otherwise gives up after 5 fast failures).
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
# audio: ALSA mic and speaker. dialout: the ESP32's USB serial port. video: the UVC camera.
SupplementaryGroups=audio dialout video
WorkingDirectory=@REPO@
# ALSA device names, the serial port override, the server address (see clara-box.env.example).
EnvironmentFile=-/etc/clara-box.env
# On the box a missing ESP32 must show as an error, never as a quietly simulated lid.
Environment=CLARA_BOARD=serial
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run dev -w @clara/box
Restart=always
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
