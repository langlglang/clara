{
  "name": "clara",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "box"
  ],
  "scripts": {
    "web": "npm run dev -w @clara/web",
    "box": "npm run dev -w @clara/box",
    "typecheck": "tsc -p packages/contracts && tsc -p packages/agent && tsc -p packages/network && tsc -p box && npm run typecheck -w @clara/web",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "@serialport/bindings-cpp@13.0.0": true,
    "esbuild@0.28.2": true
  }
}
